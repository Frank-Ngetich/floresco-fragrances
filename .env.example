# ============================================================
# FLORESCO — Environment Variables
# Copy this to .env.local and fill in your values
# NEVER commit .env.local to git
# ============================================================

# ── Database ──────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/floresco?retryWrites=true&w=majority

# ── Authentication ─────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ── M-Pesa Daraja ─────────────────────────────────────────
# Start with sandbox: developer.safaricom.co.ke
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
# Use ngrok for local testing: npx ngrok http 3000
MPESA_CALLBACK_URL=https://your-ngrok-url.ngrok-free.app/api/payment/mpesa/callback

# ── Flutterwave ───────────────────────────────────────────
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_ENCRYPTION_KEY=

# ── WhatsApp Business Cloud API ───────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=floresco_verify_2026

# ── Email (Resend) ────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=Floresco <orders@florescofragrances.co.ke>

# ── Image Storage ─────────────────────────────────────────
# Option A: Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Option B: Cloudflare R2 (preferred for CF deployment)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=floresco-images
R2_PUBLIC_URL=https://images.florescofragrances.co.ke

# ── Business ──────────────────────────────────────────────
BUSINESS_NAME=Floresco Fragrances & Accessories
BUSINESS_EMAIL=hello@florescofragrances.co.ke
BUSINESS_PHONE=254700000000
BUSINESS_ADDRESS=Kapsoya Business Park, Eldoret
NEXT_PUBLIC_SITE_URL=http://localhost:3000

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "floresco-fragrances",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env", "no_handle_cross_request_promise_resolution"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }

  // Optional: create a KV namespace and uncomment to enable Next.js
  // data-cache (ISR/revalidate) support on Cloudflare Workers.
  // Run: npx wrangler kv namespace create NEXT_CACHE_WORKERS_KV
  // "kv_namespaces": [
  //   { "binding": "NEXT_CACHE_WORKERS_KV", "id": "<BINDING_ID>" }
  // ]
}

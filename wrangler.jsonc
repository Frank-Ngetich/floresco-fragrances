{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "floresco-fragrances",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-23",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },

  "kv_namespaces": [
    { "binding": "NEXT_CACHE_WORKERS_KV", "id": "7dff21b38a2b486ca2ec2cae5d3b89ff" }
  ],

  "r2_buckets": [
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "floresco-next-cache" }
  ]
}
